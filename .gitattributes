# Normalize line endings; Godot writes LF.
* text=auto eol=lf

# Godot text formats
*.gd text
*.tscn text
*.tres text
*.godot text
*.cfg text
*.json text
*.md text

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.tpz binary
*.pck binary

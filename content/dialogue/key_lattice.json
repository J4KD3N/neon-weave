{
  "name": "The Key of the Ledgers",
  "start": [ { "node": "key" } ],
  "nodes": {
    "key": {
      "speaker": "narrator",
      "text": "A ledger-stone in a stall of dead screens, singing in columns. The Choir keeps its accounts here; the Key is the thing it counts with. A cantor stands up from behind the stall.",
      "choices": [
        { "text": "Take it whole. Kill the keeper.", "effects": { "flags": { "key_lattice_fought": true }, "enemies": [ { "type": "choir_cantor", "offset": [3, 0] }, { "type": "echo_wraith", "offset": [2, 2] }, { "type": "echo_wisp", "offset": [3, -2] } ], "victory_flag": ["key_lattice", "key_lattice_resolved"] }, "end": true },
        { "text": "Kaj-7, what is it counting?", "requires": { "recruited": "kaj7" }, "next": "call" },
        { "text": "Break it. Let the ledger lose its sum.", "effects": { "flags": { "key_lattice_broken": true, "key_lattice_resolved": true }, "reputation": { "ashfound": 1, "lattice": -2 } }, "end": true }
      ]
    },
    "call": {
      "speaker": "kaj7",
      "text": "Us. Everyone it has taken, by name, in a fifth. Take the Key; it can keep the ledger without the sum.",
      "choices": [ { "text": "Take it whole.", "effects": { "flags": { "key_lattice_fought": true, "kaj7_called_the_key": true }, "approval": { "kaj7": 1 }, "enemies": [ { "type": "choir_cantor", "offset": [3, 0] }, { "type": "echo_wraith", "offset": [2, 2] }, { "type": "echo_wisp", "offset": [3, -2] } ], "victory_flag": ["key_lattice", "key_lattice_resolved"] }, "end": true } ]
    }
  }
}

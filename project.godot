; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neon Weave"
config/description="Open-source, moddable, party-based isometric arcane-cyberpunk CRPG."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Content="*res://src/core/content_registry.gd"
Platform="*res://src/core/platform/platform_service.gd"

[debug]

; Static typing everywhere (GDD §4): an untyped declaration is a compile error.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Neon-lit melancholy starts with a dark ground; the default grey is not it.
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.07, 1)
; Pixel art: nearest-neighbour sampling, glow comes from lighting not sprites (GDD §5).
textures/canvas_textures/default_texture_filter=0
